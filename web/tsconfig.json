{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "@renderer/*": ["../src/renderer/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "../src/shared/**/*",
    "../src/renderer/src/**/*"
  ]
}
