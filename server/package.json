{
  "name": "arbor-sync-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:redis": "node scripts/redis-realtime-smoke.mjs",
    "test:s3": "node scripts/s3-blob-smoke.mjs",
    "test:blob-bindings": "tsx scripts/blob-binding-preservation-smoke.ts",
    "test:large-batch": "node scripts/large-sync-batch-smoke.mjs",
    "test:device-enrollment": "node scripts/device-enrollment-smoke.mjs",
    "test:snapshots": "node scripts/snapshot-restore-smoke.mjs",
    "test:session-heartbeat": "node scripts/session-heartbeat-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0",
    "jose": "^6.2.17",
    "pg": "^8.16.3",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
}
